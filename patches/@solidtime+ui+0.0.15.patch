+/* Tabi Desktop - Modal Dropdown Fix */
+/* Ensure dropdowns and select elements are clickable inside modals */
+[role="dialog"] *,
+[data-radix-dialog-overlay] *,
+.Modal *,
+[class*="modal"] * {
+  pointer-events: auto;
+}
+
+/* Ensure dropdown content is accessible */
+[role="listbox"],
+[role="option"],
+[role="menu"],
+[role="menuitem"],
+[data-radix-dropdown-menu-content],
+[data-radix-select-content] {
+  pointer-events: auto !important;
+}
+
+/* Fix for select/dropdown buttons */
+[role="combobox"],
+[role="button"] {
+  pointer-events: auto !important;
+  cursor: pointer;
+}
